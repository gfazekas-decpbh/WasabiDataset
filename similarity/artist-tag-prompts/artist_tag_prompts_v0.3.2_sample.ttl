<https://wsim.semanticaudio.net/similarity/v0.3.2/model> a wsim:SimilarityModel ;
    dcterms:created "2026-11-24"^^xsd:date ;
    dcterms:title "WASABI artist tag prompts v0.3.2: descriptive Last.fm tags and genres per artist, ordered by facet" ;
    prov:used <https://zenodo.org/records/5603369> ;
    prov:wasInformedBy <https://wsim.semanticaudio.net/similarity/v0.3/model> ;
    wsim:evaluation "{\"prefix_round_trip_test\": [{\"config\": \"current order (12 tags)\", \"prefix\": \"3\", \"MRR\": 0.0335, \"R10\": 0.0665, \"genre_agree10\": 0.7113}, {\"config\": \"current order (12 tags)\", \"prefix\": \"5\", \"MRR\": 0.0402, \"R10\": 0.079, \"genre_agree10\": 0.7063}, {\"config\": \"current order (12 tags)\", \"prefix\": \"full\", \"MRR\": 0.0552, \"R10\": 0.118, \"genre_agree10\": 0.7037}, {\"config\": \"facet order, same 12 tags\", \"prefix\": \"3\", \"MRR\": 0.0257, \"R10\": 0.052, \"genre_agree10\": 0.7094}, {\"config\": \"facet order, same 12 tags\", \"prefix\": \"5\", \"MRR\": 0.0335, \"R10\": 0.064, \"genre_agree10\": 0.7039}, {\"config\": \"facet order, same 12 tags\", \"prefix\": \"full\", \"MRR\": 0.0569, \"R10\": 0.1155, \"genre_agree10\": 0.7026}, {\"config\": \"facet order, genre cap 4\", \"prefix\": \"3\", \"MRR\": 0.0257, \"R10\": 0.052, \"genre_agree10\": 0.7094}, {\"config\": \"facet order, genre cap 4\", \"prefix\": \"5\", \"MRR\": 0.0378, \"R10\": 0.0745, \"genre_agree10\": 0.7075}, {\"config\": \"facet order, genre cap 4\", \"prefix\": \"full\", \"MRR\": 0.0519, \"R10\": 0.099, \"genre_agree10\": 0.7102}]}" ;
    wsim:method "Tags are the artist's genres and most characteristic descriptive Last.fm tags (not generated text). wsim:tagPrompt and wsim:rank follow the artist's own tag weight (genres first), which identified the artist best in a prefix round trip. Each tag is assigned to one facet (rules + MiniLM similarity to facet anchor words); wsim:tagPromptByFacet lists the same tags ordered by facet (genre/style, instruments, vocals, mood, tempo, era, place, other)." ;
    wsim:version "v0.3.2" .

