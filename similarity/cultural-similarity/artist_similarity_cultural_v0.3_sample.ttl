<https://wsim.semanticaudio.net/similarity/v0.3/model> a wsim:SimilarityModel ;
    dcterms:created "2026-11-23"^^xsd:date ;
    dcterms:title "WASABI artist similarity v0.3: transformer over KG concept tokens with KG-biased attention and Laplacian prior, combined with v0.1 and v0.2" ;
    prov:used <https://zenodo.org/records/5603369> ;
    prov:wasInformedBy <https://wsim.semanticaudio.net/similarity/v0.1/model>,
        <https://wsim.semanticaudio.net/similarity/v0.2/model> ;
    wsim:evaluation "[{\"n\": 320, \"P10\": 0.33, \"R10\": 0.3573, \"MAP10\": 0.2395, \"MRR\": 0.6285, \"AUC\": 0.9374, \"coverage\": 311, \"eval\": \"SAS-lastfm valid / SAS pool\", \"sas_share_nonsas\": NaN}, {\"n\": 320, \"P10\": 0.3278, \"R10\": 0.3442, \"MAP10\": 0.2343, \"MRR\": 0.6289, \"AUC\": 0.9391, \"coverage\": 312, \"eval\": \"SAS-lastfm test / SAS pool\", \"sas_share_nonsas\": NaN}, {\"n\": 320, \"P10\": 0.1688, \"R10\": 0.1761, \"MAP10\": 0.0924, \"MRR\": 0.3754, \"AUC\": 0.9534, \"coverage\": 312, \"eval\": \"SAS-lastfm test / all WASABI\", \"sas_share_nonsas\": NaN}, {\"n\": 244, \"P10\": 0.2016, \"R10\": 0.2511, \"MAP10\": 0.1206, \"MRR\": 0.4408, \"AUC\": 0.7937, \"coverage\": 237, \"eval\": \"SAS-MIREX all / MIREX pool\", \"sas_share_nonsas\": 0.08}]" ;
    wsim:features "2-layer transformer (d=128, 4 heads) over up to 24 tags, 4 genres, 4 subjects per artist; attention bias from WASABI concept graph (co-occurrence + lexical); Laplacian Tr(Z^T L Z) on token embeddings; token init from label-free ComplEx; contrastive training on SAS training pairs with random negatives from all artists" ;
    wsim:method "E1 + 0.5*E2 + 2*E3 (z = per-query standardisation)" ;
    wsim:topK 20 ;
    wsim:version "v0.3" .

