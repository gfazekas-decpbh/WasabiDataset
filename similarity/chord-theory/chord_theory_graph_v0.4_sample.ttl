        <https://wsim.semanticaudio.net/similarity/chord/iii> .

<https://wsim.semanticaudio.net/similarity/chord/IV> a wsim:ChordDegree ;
    rdfs:label "IV" ;
    wsim:sameFunctionAs <https://wsim.semanticaudio.net/similarity/chord/ii> ;
