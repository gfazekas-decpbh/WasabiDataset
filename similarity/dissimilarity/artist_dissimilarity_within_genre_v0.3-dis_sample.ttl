<https://wsim.semanticaudio.net/similarity/v0.3-dis/model> a wsim:SimilarityModel ;
    dcterms:created "2026-11-24"^^xsd:date ;
    dcterms:title "WASABI within-genre artist dissimilarity v0.3-dis: 5 least-similar artists per artist and genre" ;
    prov:used <https://zenodo.org/records/5603369> ;
    prov:wasInformedBy <https://wsim.semanticaudio.net/similarity/v0.3/model> ;
    wsim:evaluation "[{\"config\": \"random|both_tagged|tags>=20\", \"links\": 90340, \"sources\": 8232, \"genres\": 153, \"chord_dist\": 0.4386976623189094, \"tag_jaccard\": 0.1209150877301832, \"top1pct_target_share\": 0.0459043613017489, \"max_indegree\": 56, \"sas_leak\": 0.0049147664379012}, {\"config\": \"rankcons|center=True|both_tagged|tags>=20|band=0.00-0.00\", \"links\": 90340, \"sources\": 8232, \"genres\": 153, \"chord_dist\": 0.4745765486014272, \"tag_jaccard\": 0.0656531668804674, \"top1pct_target_share\": 0.0878127075492583, \"max_indegree\": 137, \"sas_leak\": 0.0001106929377905}]" ;
    wsim:features "same as v0.3; genres = merged DBpedia + album genre labels (>= 20 eligible artists)" ;
    wsim:method "v0.3 component scores (E1 TF-IDF, E2 ComplEx, E3 transformer), symmetrised; within each genre double-centred (row and column means removed) and converted to within-row percentiles; consensus = max percentile over the three views; the 5 lowest are kept. Artists need >= 20 Last.fm tags, and the Last.fm tags of both artists must mention the genre." ;
    wsim:topK 5 ;
    wsim:version "v0.3-dis" .

